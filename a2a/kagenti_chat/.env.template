# Logging
LOG_LEVEL=INFO

# A2A Server
A2A_HOST=0.0.0.0
A2A_PORT=8000
# Public URL advertised in the AgentCard (set when deploying behind a gateway/ingress)
# A2A_PUBLIC_URL=http://kagenti-chat.team1.localtest.me:8080/

# LLM (OpenAI-compatible endpoint)
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_API_KEY=dummy
# In-cluster: hit the llm-d gateway with the per-model path-prefix.
# Local dev: port-forward the gateway and point at http://localhost:8080/<model-prefix>/v1
LLM_API_BASE=http://infra-inference-scheduling-inference-gateway-istio.llm-d.svc/meta-llama-llama-3-3-70b-instruct/v1
# EXTRA_HEADERS='{"x-foo": "bar"}'

# LLM sampling
LLM_TEMPERATURE=0.2

# Tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_CONSOLE_TRACING=false
