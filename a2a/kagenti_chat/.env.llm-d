# Local development against llm-d via `kubectl port-forward`.
#
# In one terminal:
#   kubectl -n llm-d port-forward svc/infra-inference-scheduling-inference-gateway-istio 8080:80
#
# Then:
#   uv run server
#
# Switch LLM_MODEL + the path prefix in LLM_API_BASE together. Available prestaged models:
#   meta-llama/Llama-3.1-8B-Instruct      -> /meta-llama-llama-3-1-8b-instruct/v1
#   meta-llama/Llama-3.1-70B-Instruct     -> /meta-llama-llama-3-1-70b-instruct/v1
#   meta-llama/Llama-3.3-70B-Instruct     -> /meta-llama-llama-3-3-70b-instruct/v1   (default)
#   openai/gpt-oss-20b                    -> /openai-gpt-oss-20b/v1
#   openai/gpt-oss-120b                   -> /openai-gpt-oss-120b/v1                 (32K context)

LOG_LEVEL=INFO
A2A_HOST=0.0.0.0
A2A_PORT=8000

LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_API_KEY=dummy
LLM_API_BASE=http://localhost:8080/meta-llama-llama-3-3-70b-instruct/v1

LLM_TEMPERATURE=0.2
